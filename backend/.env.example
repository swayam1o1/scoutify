PORT=5001
MONGO_URI=example/scoutify
JWT_SECRET=replace_with_long_random_secret
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
GEMINI_API_KEY=your_gemini_api_key
ENABLE_PAYMENT_SIMULATION=false
TOTP_ISSUER=Scoutify

# Local: set false to skip AWS Secrets Manager and use this .env file
USE_AWS_SECRETS=false
# AWS_REGION=ap-south-2
# AWS_SECRET_ID=scoutify/dev/backend-secrets

# Optional: real email OTP (otherwise OTP prints in server console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Scoutify <noreply@scoutify.in>

# Optional: real SMS OTP via Twilio (otherwise OTP prints in server console)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Google Sign-In (must match VITE_GOOGLE_CLIENT_ID on frontend)
# GOOGLE_CLIENT_ID=
